// Type checking only: `npm run typecheck` runs vue-tsc on this project, and
// Vite (Oxc) transpiles each file on its own without type checking.
//
// One project covers the app (src/), the tests (test/, which Vitest runs in
// jsdom, so they need the same DOM types) and vite.config.ts. The app /
// Node / tests project references that create-vue sets up would only differ
// for vite.config.ts, which uses no Node APIs, so they aren't worth three
// more configs here.
{
    "compilerOptions": {
        // Vite's default browser targets (Baseline Widely Available) support
        // ES2022 but not all of ES2023 (e.g. toSorted() in Firefox 114), and
        // Vite doesn't polyfill
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "resolveJsonModule": true,
        // Each file must be transpilable on its own, as Vite does
        "isolatedModules": true,
        // Types are imported with `import type` (as in @vue/tsconfig), so
        // the imports a file keeps are the ones it writes
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        // Global types: only Vite's client types (import.meta.env, asset
        // imports). Tests import from 'vitest' explicitly.
        "types": ["vite/client"],
        "strict": true,
        "noUnusedLocals": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src/**/*.ts", "src/**/*.vue", "test/**/*.ts", "vite.config.ts"]
}
