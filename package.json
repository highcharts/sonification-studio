{
  "name": "highcharts-sonification-studio",
  "version": "1.1.1",
  "description": "Edit and visualize data with charts and sound",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "publish": "npm run lint && npm test && npm run build && node scripts/publish.mjs"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint && npm test"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/highcharts/sonification-studio.git"
  },
  "keywords": [
    "sonification",
    "dataviz",
    "chart",
    "data"
  ],
  "author": "Highsoft AS",
  "license": "SEE LICENSE IN LICENSE.md",
  "bugs": {
    "url": "https://github.com/highcharts/sonification-studio/issues"
  },
  "homepage": "https://github.com/highcharts/sonification-studio#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^3.1.0",
    "jsdom": "^31.0.1",
    "less": "^4.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vue-eslint-parser": "^10.4.2"
  },
  "dependencies": {
    "@highcharts/grid-pro": "^3.2.0",
    "highcharts": "^13.1.1",
    "highcharts-vue": "^2.0.2",
    "lz-string": "^1.5.0",
    "mathjs": "^7.1.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.2",
    "vuex": "^4.1.0"
  }
